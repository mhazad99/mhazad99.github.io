---
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
import { parse } from 'yaml';
import config from '../../site.config.mjs';
import gh from '../data/github.json';
import extraText from '../data/projects.yaml?raw';
import Hypnogram from '../components/Hypnogram.astro';

const extra = parse(extraText) ?? {};
const name = config.name || gh.profile?.name || config.githubUser;
const tagline = config.tagline || gh.profile?.bio || config.fallbackTagline;
const avatar = gh.profile?.avatar;

// GitHub projects: repos with the portfolio topic, or all your own repos until you tag some.
const visible = gh.repos.filter((r) => !r.archived && !config.hide.includes(r.name));
const tagged = visible.filter((r) => r.topics.includes(config.portfolioTopic));
const chosen = tagged.length ? tagged : visible.filter((r) => !r.fork);
const overrides = extra.github ?? {};
const pretty = (s) => s.replace(/[-_]+/g, ' ');

const items = [
  ...chosen.map((r) => {
    const o = overrides[r.name] ?? {};
    return {
      title: o.title ?? pretty(r.name),
      description: o.description ?? r.description,
      date: new Date(r.pushedAt),
      updated: true,
      url: r.url,
      linkText: 'Code on GitHub',
      homepage: r.homepage,
      language: r.language,
      stars: r.stars,
    };
  }),
  ...(extra.other ?? []).filter(Boolean).map((p) => ({
    title: p.title,
    description: p.description,
    date: new Date(String(p.date)),
    updated: false,
    url: p.url,
    linkText: p.where ? `View on ${p.where}` : 'View',
    where: p.where,
  })),
].sort((a, b) => b.date - a.date);

const month = (d) => d.toLocaleDateString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const lastSync = new Date(gh.fetchedAt).toLocaleDateString('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const year = new Date().getUTCFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{name}</title>
    <meta name="description" content={tagline} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={name} />
    <meta property="og:description" content={tagline} />
    <meta property="og:url" content={Astro.site} />
    {avatar && <meta property="og:image" content={avatar} />}
  </head>
  <body>
    <header class="hero">
      <div class="wrap">
        <h1>{name}</h1>
        <p class="tagline">{tagline}</p>
      </div>
      <div class="wrap trace-wrap">
        <Hypnogram />
      </div>
    </header>

    <main class="wrap">
      <section class="about" aria-label="About">
        {avatar && <img class="avatar" src={avatar} alt="" width="88" height="88" />}
        <div>
          <p class="bio">{config.bio}</p>
          <ul class="links">
            {config.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
          </ul>
        </div>
      </section>

      <section class="projects" aria-labelledby="projects-h">
        <h2 id="projects-h">Projects</h2>
        <p class="lede">Ordered by most recent activity.</p>
        <ol class="list">
          {items.map((p) => (
            <li class="item">
              <time datetime={p.date.toISOString()}>
                {p.updated && <span class="sr-only">Updated </span>}{month(p.date)}
              </time>
              <div class="body">
                <h3>{p.url ? <a href={p.url}>{p.title}</a> : p.title}</h3>
                {p.description && <p class="desc">{p.description}</p>}
                <ul class="meta">
                  {p.language && <li>{p.language}</li>}
                  {p.where && !p.url && <li>{p.where}</li>}
                  {p.stars > 0 && <li>{p.stars} {p.stars === 1 ? 'star' : 'stars'}</li>}
                  {p.homepage && <li><a href={p.homepage}>Website</a></li>}
                  {p.url && <li><a href={p.url}>{p.linkText}</a></li>}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer class="wrap foot">
      <p>Projects update from GitHub automatically. Last updated {lastSync}.</p>
      <p>© {year} {name}</p>
    </footer>
  </body>
</html>

<style>
  .hero { padding-block: clamp(3rem, 9vw, 6.5rem) 0; }
  h1 {
    font-size: clamp(2.75rem, 8.5vw, 6rem);
    line-height: 0.98;
    font-weight: 760;
    letter-spacing: -0.035em;
    max-width: 14ch;
    overflow-wrap: anywhere;
  }
  .tagline {
    margin-top: 1rem;
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    color: var(--muted);
    max-width: 42ch;
    line-height: 1.35;
  }
  .trace-wrap { margin-top: clamp(2.5rem, 6vw, 4rem); }

  .about {
    margin-top: clamp(3rem, 7vw, 5rem);
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    max-width: var(--text);
  }
  .avatar { border-radius: 50%; flex: none; background: var(--grid); }
  .bio { font-size: 1.125rem; line-height: 1.6; }
  .links {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-weight: 600;
  }

  .projects { margin-top: clamp(4rem, 9vw, 6rem); }
  h2 {
    font-size: 1.75rem;
    font-weight: 720;
    letter-spacing: -0.02em;
  }
  .lede { margin-top: 0.25rem; color: var(--muted); }
  .list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    border-top: 1px solid var(--rule);
  }
  .item {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, var(--text));
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--rule);
  }
  time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }
  h3 {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  h3 a { text-decoration-color: transparent; }
  h3 a:hover { text-decoration-color: var(--rem); }
  .desc { margin-top: 0.4rem; }
  .meta {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .foot {
    margin-top: clamp(4rem, 9vw, 6rem);
    padding-block: 2rem 3rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .item { grid-template-columns: 1fr; gap: 0.35rem; }
    .about { flex-direction: column; gap: 1rem; }
  }
</style>
